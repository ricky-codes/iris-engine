# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Limite do corpo do pedido, em bytes (1 MB)
MAX_BODY_BYTES=1048576
# Tempo máximo para terminar pedidos em curso ao parar
SHUTDOWN_TIMEOUT_MS=10000
# Postgres. Sem isto o serviço arranca sem base de dados.
# DATABASE_URL=postgres://iris:iris@localhost:5432/iris
# Pasta com as migrações SQL (relativa ao diretório de trabalho)
MIGRATIONS_DIR=migrations
