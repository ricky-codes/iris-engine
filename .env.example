# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Limite do corpo do pedido, em bytes (1 MB)
MAX_BODY_BYTES=1048576
# Tempo máximo para terminar pedidos em curso ao parar
SHUTDOWN_TIMEOUT_MS=10000
# Postgres. Sem isto o serviço arranca sem base de dados.
# DATABASE_URL=postgres://iris:iris@localhost:5432/iris
# Pasta com as migrações SQL (relativa ao diretório de trabalho)
MIGRATIONS_DIR=migrations

# ---------- Motor ----------
# Sem API_SECRET, STEPACCESS_* (ou STEPACCESS_BYPASS) e OPENROUTER_API_KEY o serviço arranca
# só com /healthz e /readyz. Em produção são todos obrigatórios.

# Segredo partilhado que o Salesforce envia em "Authorization: Bearer <segredo>" (mínimo 32
# caracteres). Gerar com: openssl rand -base64 48
# API_SECRET=

# StepAccess: decide se o utilizador tem acesso e conta a utilização. Ou todos ou nenhum.
# STEPACCESS_URL=https://access.exemplo.pt
# STEPACCESS_USER=
# STEPACCESS_PASSWORD=
# STEPACCESS_COMPONENT_UUID=
# STEPACCESS_TIMEOUT_MS=3000
# Só fora de produção: deixa passar todos os pedidos sem perguntar ao StepAccess.
# STEPACCESS_BYPASS=true

# OpenRouter (modelos de IA). A chave nunca vai para o Git: fica só neste ficheiro .env.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo usado quando a ferramenta não tem configuração na base de dados.
# LLM_DEFAULT_MODEL=google/gemini-2.5-flash

# Ferramenta "diagnostic", para testar o caminho completo sem o Salesforce.
# ENABLE_DIAGNOSTIC_TOOL=true
