# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Limite do corpo do pedido, em bytes (1 MB)
MAX_BODY_BYTES=1048576
# Tempo máximo para terminar pedidos em curso ao parar
SHUTDOWN_TIMEOUT_MS=10000
# Postgres. Sem isto o serviço arranca sem base de dados.
# DATABASE_URL=postgres://iris:iris@localhost:5432/iris
# Pasta com as migrações SQL (relativa ao diretório de trabalho)
MIGRATIONS_DIR=migrations

# ---------- Motor ----------
# Sem API_SECRET, o controlo de acesso (STEPACCESS_*, ou ACCESS_MODE=open) e OPENROUTER_API_KEY
# o serviço arranca só com /healthz e /readyz. Em produção são todos obrigatórios.

# Segredo partilhado que o Salesforce envia em "Authorization: Bearer <segredo>" (mínimo 32
# caracteres). Gerar com: openssl rand -base64 48
# API_SECRET=

# Quem controla o acesso às ferramentas:
#   stepaccess (por omissão): licenças e contagem de utilização no StepAccess (STEPACCESS_* abaixo).
#   open: só o API_SECRET, sem StepAccess (o custo de cada pedido fica nos logs). Permitido em
#         produção; não se usa com STEPACCESS_* nem com STEPACCESS_BYPASS.
# ACCESS_MODE=stepaccess

# StepAccess: decide se o utilizador tem acesso e conta a utilização. Ou todos ou nenhum.
# STEPACCESS_URL=https://access.exemplo.pt
# STEPACCESS_USER=
# STEPACCESS_PASSWORD=
# STEPACCESS_COMPONENT_UUID=
# STEPACCESS_TIMEOUT_MS=3000
# Só fora de produção: deixa passar todos os pedidos sem perguntar ao StepAccess.
# STEPACCESS_BYPASS=true

# OpenRouter (modelos de IA). A chave nunca vai para o Git: fica só neste ficheiro .env.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo usado quando a ferramenta não tem configuração na base de dados.
# LLM_DEFAULT_MODEL=google/gemini-2.5-flash
# Modelos de recurso dessas ferramentas, por ordem, separados por vírgulas (máximo 3). Quando o
# modelo principal ou o OpenRouter falha, o motor experimenta estes.
# LLM_FALLBACK_MODELS=openai/gpt-4.1-mini,anthropic/claude-haiku-4.5
# Teto de tempo para todas as chamadas ao modelo de um pedido (2000 a 115000 ms). Tem de ficar
# abaixo do limite de callout do Apex (120 s).
# LLM_TOTAL_TIMEOUT_MS=30000

# Ferramenta "diagnostic", para testar o caminho completo sem o Salesforce.
# ENABLE_DIAGNOSTIC_TOOL=true

# Alertas por webhook (n8n, Slack, email…). URL e segredo: os dois ou nenhum. Sem eles, os
# alertas são calculados e ficam visíveis em /v1/admin/alerts, mas não são enviados.
# ALERT_WEBHOOK_URL=https://n8n.exemplo.pt/webhook/iris-alertas
# Segredo da assinatura HMAC (cabeçalho X-Iris-Signature), mínimo 32 caracteres.
# ALERT_WEBHOOK_SECRET=
# iris (JSON completo) ou slack ({ text }).
# ALERT_WEBHOOK_FORMAT=iris
# ALERT_EVAL_INTERVAL_MS=60000
# Janela para as taxas de falhas (pelo menos o dobro do intervalo).
# ALERT_WINDOW_MS=900000
# Lembrete enquanto o alerta se mantém.
# ALERT_REPEAT_MS=14400000
# Endereço da consola, para o alerta levar um link.
# CONSOLE_URL=https://hub.exemplo.pt/iris

# API de administração (/v1/admin), usada pelo backend do StepAccess. Mínimo 32 caracteres e
# diferente do API_SECRET. Sem isto a API de administração não existe. Ver docs/ADMIN_API.md.
# ADMIN_API_SECRET=
